{
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin dev*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git merge*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git push*--no-verify*)"
    ]
  }
}
