# Cấu hình app web công khai. Sao chép thành .env.local (git bỏ qua) rồi điền.
# Hiện app chạy bằng dữ liệu mẫu nên chưa biến nào là bắt buộc; dòng trống = tính năng đó tắt.

# Địa chỉ gốc của site, dùng cho canonical, sitemap và link chia sẻ.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trang quản trị cho nút "Quản trị" ở header. Production cùng tên miền thì để dạng comment (mặc định /admin).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001/admin
# API gateway (Nginx). Server Next gọi qua địa chỉ nội bộ, trình duyệt gọi qua địa chỉ công khai.
API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Khóa bí mật cho webhook làm mới trang (api/revalidate), nhận từ các service khi dữ liệu đổi.
REVALIDATE_SECRET=

# Google Maps JavaScript API (bản đồ thật thay cho bản đồ sơ lược).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Tag Manager (GA4, Meta Pixel).
NEXT_PUBLIC_GTM_ID=

# Đăng nhập Google (giai đoạn 2), dùng ở route BFF api/auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary cloud name cho loader ảnh next/image.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
