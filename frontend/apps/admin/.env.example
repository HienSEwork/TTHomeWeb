# Cấu hình app quản trị. Sao chép thành .env.local (git bỏ qua) rồi điền.
# Hiện app chạy bằng dữ liệu mẫu nên chưa biến nào là bắt buộc.

# Địa chỉ trang công khai (link "Xem trên web" từ trang quản trị).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API gateway (Nginx): các route /api/v1/admin/*.
API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Cloudinary cloud name để xem trước ảnh khi tải lên.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
