# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# Every service reads these variables from its application.yml.
# Services load this file themselves (spring.config.import), so write plain KEY=value: no quotes, no "export".

# --- Spring profile -------------------------------------------------------
# Leave unset for local development (defaults to "dev"). Use "prod" in production.
# SPRING_PROFILES_ACTIVE=prod

# --- Database: Supabase PostgreSQL ---------------------------------------
# Supabase project reference (Dashboard > Project Settings > General).
SUPABASE_PROJECT_REF=your-project-ref
# Session pooler JDBC URL, port 5432 (Dashboard > Connect > JDBC).
# Do NOT use the transaction pooler (port 6543): it does not support prepared statements.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Password of the per-service role created by db/supabase_roles.sql.
# All services share this variable name; set it per service when running them.
DB_PASSWORD=change-me
# Optional. Default is <service>_svc.<SUPABASE_PROJECT_REF>, e.g. identity_svc.<ref>.
# DB_USER=identity_svc.your-project-ref
# Optional. Max Hikari connections per service (default 3; 11 services share the pooler limit).
# DB_POOL_MAX=3
# Optional. Direct/session connection for Flyway migrations (default: SUPABASE_DB_URL).
# FLYWAY_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# --- RabbitMQ -------------------------------------------------------------
RABBIT_HOST=localhost
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# --- identity-service ---------------------------------------------------------
# Required, no defaults. Generate each with: openssl rand -base64 48
# Signing key of access tokens (JWT, HS256), at least 32 bytes.
JWT_SECRET=change-me-generate-a-long-random-value
# Server-side pepper for hashing OTP codes, at least 16 bytes.
OTP_PEPPER=change-me-generate-a-random-value

# --- Email delivery (identity-service) -----------------------------------------
# false (default): codes are only written to the log, on dev profiles only.
# true: email codes are sent through the SMTP server below; SMS has no provider yet and is refused with 503.
MAIL_ENABLED=false
# SMTP server with STARTTLS (e.g. smtp.gmail.com:587 with an app password, or any transactional provider).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=change-me
# Sender shown to the recipient. Must be an address your SMTP account is allowed to send from.
MAIL_FROM=TTHome <no-reply@example.com>

# --- First administrator (identity-service) -------------------------------------
# Nobody is an admin after a fresh install. Set both once, start identity-service, sign in, then REMOVE the password
# line. Ignored as soon as any admin exists. An existing account with this email is promoted and keeps its password.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-8-characters

# --- Cloudinary (media-service) --------------------------------------------
# Leave empty until the account exists; the upload-signature endpoint then answers 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
