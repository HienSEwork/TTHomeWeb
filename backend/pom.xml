<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>vn.tthome</groupId>
	<artifactId>tthome-backend</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>tthome-backend</name>

	<modules>
		<module>tthome-common</module>
		<module>tthome-events</module>
		<module>services/identity-service</module>
		<module>services/meey-sync-service</module>
		<module>services/listing-service</module>
		<module>services/search-service</module>
		<module>services/media-service</module>
		<module>services/crm-service</module>
		<module>services/booking-service</module>
		<module>services/consignment-service</module>
		<module>services/cms-service</module>
		<module>services/notification-service</module>
		<module>services/report-service</module>
	</modules>

	<properties>
		<mapstruct.version>1.6.3</mapstruct.version>
		<springdoc.version>3.2.0</springdoc.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<!-- Tests tagged "supabase" hit the dev Supabase database: excluded by default, enabled by -Psupabase -->
		<test.excluded.groups>supabase</test.excluded.groups>
		<test.groups></test.groups>
		<test.includes>**/*Test.java,**/*Tests.java</test.includes>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>vn.tthome</groupId>
				<artifactId>tthome-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>vn.tthome</groupId>
				<artifactId>tthome-events</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Lombok + MapStruct dùng chung cho mọi module (bắt buộc đúng thứ tự processor) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombok-mapstruct-binding.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<groups>${test.groups}</groups>
					<excludedGroups>${test.excluded.groups}</excludedGroups>
					<includes>
						<include>${test.includes}</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- ./mvnw -pl services/identity-service -am -Psupabase test : runs only the *SupabaseIT tests against the dev database -->
		<profile>
			<id>supabase</id>
			<properties>
				<test.groups>supabase</test.groups>
				<test.excluded.groups></test.excluded.groups>
				<test.includes>**/*SupabaseIT.java</test.includes>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
